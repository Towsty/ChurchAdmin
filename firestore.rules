rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuper() {
      let userData = getUserData();
      return userData != null && userData.role == 'super';
    }

    function isAdmin() {
      let userData = getUserData();
      return userData != null && userData.role == 'admin';
    }

    function isLeader() {
      let userData = getUserData();
      return userData != null && userData.role == 'leader';
    }

    function userChurchId() {
      return getUserData().churchId;
    }

    function isChurchAdmin(churchId) {
      let userData = getUserData();
      return userData != null && 
        userData.role == 'admin' && 
        userData.churchId == churchId;
    }

    function isChurchMember(churchId) {
      let userData = getUserData();
      return userData != null && userData.churchId == churchId;
    }

    function isUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && 
        (
          isSuper() ||  // Super users can read all
          request.auth.uid == userId ||  // Users can read their own data
          (isAdmin() && resource.data.churchId == userChurchId()) ||  // Admins can read all users in their church
          (isChurchMember(resource.data.churchId)) // Members can read other members in their church
        );
      
      allow create: if isSignedIn() && (isSuper() || request.auth.uid == userId);
      allow update: if isSignedIn() && 
        (
          isSuper() ||  // Super users can do anything
          (request.auth.uid == userId && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'churchId']) || // Users can't change role or churchId
            request.resource.data.diff(resource.data).affectedKeys().hasAll(['phone', 'address', 'firstName', 'lastName']) // But they can update their profile fields
          )) ||
          (isAdmin() && (resource == null || resource.data.churchId == userChurchId()) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))  // Admins can update users in their church except roles
        );
      allow delete: if isSignedIn() && (isSuper() || (isAdmin() && resource.data.churchId == userChurchId()));

      // Allow list queries for users in the same church
      allow list: if isSignedIn() && (
        isSuper() ||  // Super users can list all
        (isChurchMember(resource.data.churchId) && resource.data.churchId == userChurchId())  // Members can list users in their church
      );
    }

    // Notifications collection
    match /notifications/{notificationId} {
      function getNotification() {
        return get(/databases/$(database)/documents/notifications/$(notificationId)).data;
      }
      
      // Users can read their own notifications
      allow read: if isUser(resource.data.userId);

      // Allow creating notifications
      allow create: if isSignedIn();
      
      // Allow users to update and delete their own notifications
      allow update: if isUser(resource.data.userId);
      allow delete: if isUser(getNotification().userId);
    }

    // Churches collection
    match /churches/{churchId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isSuper() || isAdmin());
      allow update, delete: if isSignedIn() && (isSuper() || (isAdmin() && churchId == userChurchId()));

      // Small Groups subcollection
      match /smallGroups/{groupId} {
        function isGroupLeader() {
          let group = get(/databases/$(database)/documents/churches/$(churchId)/smallGroups/$(groupId)).data;
          return group != null && request.auth.uid == group.leaderId;
        }

        function isGroupMember() {
          let group = get(/databases/$(database)/documents/churches/$(churchId)/smallGroups/$(groupId)).data;
          return group != null && request.auth.uid in group.members;
        }

        allow read: if isSignedIn() && churchId == userChurchId();
        allow create: if isSignedIn() && (isSuper() || (isAdmin() && churchId == userChurchId()));
        allow update: if isSignedIn() && (
          isSuper() ||
          (isAdmin() && churchId == userChurchId()) ||
          (isLeader() && isGroupLeader())
        );
        allow delete: if isSignedIn() && (isSuper() || (isAdmin() && churchId == userChurchId()));

        // Posts subcollection
        match /posts/{postId} {
          allow read: if isSignedIn() && churchId == userChurchId() && (isGroupMember() || isGroupLeader());
          allow create, update: if isSignedIn() && churchId == userChurchId() && (
            isSuper() ||
            isAdmin() ||
            isGroupLeader() ||
            (isGroupMember() && request.resource.data.type == 'member_post')
          );
          allow delete: if isSignedIn() && churchId == userChurchId() && (
            isSuper() ||
            isAdmin() ||
            (isGroupLeader() && resource.data.authorId == request.auth.uid) ||
            (isGroupMember() && resource.data.authorId == request.auth.uid && resource.data.type == 'member_post')
          );
        }

        // Attendance subcollection
        match /attendance/{recordId} {
          allow read: if isSignedIn() && churchId == userChurchId();
          allow create, update: if isSignedIn() && churchId == userChurchId() && (
            isSuper() ||
            isAdmin() ||
            (isLeader() && isGroupLeader())
          );
          allow delete: if isSignedIn() && (isSuper() || (isAdmin() && churchId == userChurchId()));
        }
      }

      // Devotionals subcollection
      match /devotionals/{devotionalId} {
        allow read: if isSignedIn() && churchId == userChurchId();
        allow write: if isSignedIn() && (isSuper() || (isAdmin() && churchId == userChurchId()));
      }

      // Announcements subcollection
      match /announcements/{announcementId} {
        allow read: if isSignedIn() && churchId == userChurchId();
        allow create, update: if isSignedIn() && (
          isSuper() ||
          (isAdmin() && churchId == userChurchId()) ||
          (isLeader() && request.resource.data.type == 'group_announcement' && 
           request.resource.data.groupId != null && 
           get(/databases/$(database)/documents/churches/$(churchId)/smallGroups/$(request.resource.data.groupId)).data.leaderId == request.auth.uid)
        );
        allow delete: if isSignedIn() && (
          isSuper() ||
          (isAdmin() && churchId == userChurchId()) ||
          (isLeader() && resource.data.type == 'group_announcement' && 
           resource.data.authorId == request.auth.uid)
        );
      }

      // Meetings subcollection
      match /meetings/{meetingId} {
        allow read: if isSignedIn() && churchId == userChurchId();
        allow write: if isSignedIn() && (isSuper() || (isAdmin() && churchId == userChurchId()));
      }

      // Join requests subcollection
      match /joinRequests/{requestId} {
        allow create: if isSignedIn();
        allow read: if isSignedIn() && (
          isSuper() ||
          request.auth.uid == requestId ||
          (isAdmin() && churchId == userChurchId())
        );
        allow update, delete: if isSignedIn() && (
          isSuper() ||
          (isAdmin() && churchId == userChurchId()) ||
          (request.auth.uid == requestId)
        );
      }

      // Members subcollection
      match /members/{memberId} {
        allow read: if isSignedIn() && churchId == userChurchId();
        allow write: if isSignedIn() && (isSuper() || (isAdmin() && churchId == userChurchId()));
      }
    }
  }
} 